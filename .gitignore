# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Ortam değişkenleri — asla commit etme
.env
.env.local
.env.*.local
.env.bak
.env.*.bak

# SSL sertifikaları/anahtarları — asla commit etme
infra/nginx/ssl/
*.crt
*.key
*.pem

# Docker
.docker/

# Model dosyaları — klasör yapısı git'te durur, içerik ignore'lanır
models/base/**
models/adapters/**
models/lora/**
models/merged/**
models/candidates/**
models/approved/**
models/whisper/**
# .gitkeep dosyaları hariç tut (klasörlerin git'te görünmesi için)
!models/base/.gitkeep
!models/adapters/.gitkeep
!models/lora/.gitkeep
!models/merged/.gitkeep
!models/candidates/.gitkeep
!models/approved/.gitkeep
!models/whisper/.gitkeep
# /opt altındaki gerçek model deposuna symlink — asla commit etme
models/models
# Model binary uzantıları (herhangi bir yerde)
*.safetensors
*.bin
*.pt
*.gguf
# HuggingFace indirme cache'i
.cache/
**/.cache/
*.metadata
*.lock

# Veri — klasör yapısı git'te durur (.gitkeep), içerik ignore'lanır
data/**
!data/**/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo

# Colab geliştirme artefaktları — platforma migrate edildi, silinebilir
lib/
lib-*.zip

# Test artifacts (test source and deterministic seed scripts stay versioned)
.pytest_cache/
.coverage
htmlcov/

# macOS
.DS_Store

# Loglar
*.log
logs/

# Postgres yedekleri
*.sql.gz
*.dump

# Node (supervisor-panel ileride)
node_modules/
.next/

docs/rules/*