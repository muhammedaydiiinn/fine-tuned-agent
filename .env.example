PROJECT_NAME=anrufblocker-platform
ENVIRONMENT=staging

# API Key koruması (X-API-Key header)
# Boş bırakılırsa kontrol atlanır → local dev için uygundur
# Prod'da doldur: openssl rand -hex 32
API_KEY=
# Internal-only token used to authorize candidate routing during eval runs.
# Required when ENVIRONMENT=production.
EVAL_INTERNAL_TOKEN=

# PostgreSQL
POSTGRES_DB=anrufblocker
POSTGRES_USER=anrufblocker
POSTGRES_PASSWORD=123456
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Internal backend URL used by the panel and eval worker
AGENT_BACKEND_URL=http://agent-backend:8010

# Eval worker
EVAL_REQUEST_TIMEOUT_SECONDS=45
EVAL_PASS_THRESHOLD=0.80
EVAL_JSON_VALIDITY_MIN=1.0
EVAL_REQUIRED_KEY_COVERAGE_MIN=1.0
EVAL_NEXT_ACTION_ACCURACY_MIN=0.80
EVAL_HARD_DECLINE_MIN=1.0
EVAL_IDENTITY_BEFORE_LINK_MIN=1.0
EVAL_PRICE_CORRECTNESS_MIN=1.0
EVAL_SECURITY_CORRECTNESS_MIN=1.0
EVAL_LOOP_REPETITION_MAX=0.0

# vLLM
# VLLM_MODE: "real" = GPU sunucu, "mock" = GPU'suz lokal geliştirme
VLLM_MODE=real
VLLM_BASE_URL=http://vllm-server:8000/v1
VLLM_MODEL_NAME=anrufblocker-production
PRODUCTION_SERVED_MODEL_NAME=anrufblocker-production
PRODUCTION_MODEL_PATH=/models/production/current
MODEL_MANAGER_URL=http://model-manager:8030
MODEL_MANAGER_TOKEN=
MODEL_HEALTH_TIMEOUT_SECONDS=15
VLLM_START_TIMEOUT_SECONDS=900
ALLOW_MOCK_PRODUCTION_DEPLOY=false

# Isolated candidate serving slot (GPU profile)
CANDIDATE_MODEL_PATH=./models/candidates/current
CANDIDATE_MODEL_NAME=anrufblocker-candidate
CANDIDATE_PUBLISH_PATH=/models/candidates/current
CANDIDATE_VLLM_BASE_URL=http://vllm-candidate:8000/v1
# Real evaluations require vLLM to be restarted with its served model name set
# to the generated version name (for example anrufblocker-v15). This prevents a
# stale process from passing health/eval checks after the artifact path changes.

# Model yolları (GPU sunucuda)
MODEL_ACTIVE_VERSION=anrufblocker-v14
MODEL_DIR=/models
MODEL_MERGED_PATH=/models/merged/anrufblocker-v14
# Production default is real. Use docker-compose.local.yml and TRAINING_MODE=mock
# for GPU-free local development.
TRAINING_MODE=real
# Mask training loss to assistant tokens only (response-only). Real path only.
TRAIN_ON_RESPONSES_ONLY=true

# ── Hibrit LLM-judge + kapalı-döngü auto-training ────────────────────────────
# Judge = production BASE modelin kendisi (aynı vLLM sunucusu). Additive/görünürlük;
# deterministik deploy gate'i ASLA etkilemez. vLLM --max-loras >=2 kalmalı
# (base-judge + aday-adapter aynı anda). VLLM_MODE=mock iken judge deterministik.
JUDGE_ENABLED=true
JUDGE_MODEL_NAME=
JUDGE_TEMPERATURE=0.1
JUDGE_MAX_TOKENS=400
JUDGE_PASS_THRESHOLD=0.7
# NL-editor: "auto" (LLM sonra deterministik fallback) | "llm" | "deterministic"
REVIEW_COMPILER_MODE=auto
# eval-worker gerçek-log judge batch
JUDGE_CONCURRENCY=1
REAL_LOG_MAX_TURNS=200
JUDGE_REQUEST_TIMEOUT_SECONDS=60
# Auto-train zamanlayıcı (agent-backend içi thread). Eşik dolunca eğitir; production'a
# alma yine tek insan onayı (/approve-and-deploy) ister — self-promote YOK.
AUTO_TRAIN_ENABLED=false
AUTO_TRAIN_THRESHOLD=30
AUTO_TRAIN_CHECK_INTERVAL_SECONDS=900

# Ses kaydı yükleme → transkripsiyon → eğitim (Recordings sayfası)
# "real" = GPU host'ta transcribe-worker kuyruğu kullanılır;
# "mock" = upload hazır segmentler yazar, worker gerekmez (lokal dev/CI).
TRANSCRIBE_MODE=real
# GPU bellek baskısında ucuz fallback: int8_float16
TRANSCRIBE_COMPUTE_TYPE=float16

# Browser voice / LiveKit (Milestone 7)
LIVEKIT_URL=ws://livekit-server:7880
# Browser'ın erişebildiği URL. Prod'da wss://voice.example.com kullan.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# GPU sunucusunun public IP'si. WebRTC ICE candidate'leri bu IP üzerinden üretilir.
# Ayarlanmazsa 127.0.0.1 kullanılır — lokal dev'de doğru, prod'da WebRTC bağlanamaz.
LIVEKIT_NODE_IP=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
LIVEKIT_AGENT_NAME=anrufblocker-voice

# Whisper STT modeli
# İndirmek için: bash infra/scripts/download_models.sh
WHISPER_MODEL_PATH=/models/whisper/whisper-large-v3-turbo-german-ct2
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=de
WHISPER_BEAM_SIZE=1

# M7 turn boundary ayarları. M8'de gelişmiş VAD/interruption ile değiştirilecek.
SPEECH_RMS_THRESHOLD=350
SPEECH_MIN_MS=250
SPEECH_END_SILENCE_MS=700
SPEECH_MAX_MS=20000
SPEECH_PREROLL_MS=240

# Gerçekçi konuşma — barge-in & backchannel (M8+).
# Gerçek-zamanlı partial transkript + erken barge-in (müşteriyi anlık duyma).
ENABLE_PARTIAL_TRANSCRIPTS=true
PARTIAL_INTERVAL_MS=300
EARLY_INTERRUPT_MIN_SPEECH_MS=500
# Overlap'e göre barge-in pencereleri (boş bırakılırsa BARGE_IN_MIN_MS'e düşer).
# playback: agent konuşurken gerçek kesinti bu kadar sonra durur (kısa = hızlı).
# active_turn: backend meşgulken muhafazakâr; tur düşürülmez, yeni utterance kuyruğa girer.
BARGE_IN_MIN_MS=800
BACKCHANNEL_WINDOW_MS=600
INTERRUPT_CONFIRM_MS=800
# STT boş ama ses YÜKSEK olduğunda yalnızca SÜRDÜRÜLMÜŞSE kesinti say (emfatik "JA!" değil).
BARGE_IN_LOUD_RMS=1500
BARGE_IN_LOUD_MIN_MS=400
# Kesilen yanıtta müşterinin gerçekte duyduğu kısmı tahmin için konuşma hızı (char/sn).
SPEAKING_CHARS_PER_SECOND=14

# Fish Audio streaming TTS. Lokal stack smoke testi için TTS_MODE=mock kullanılabilir.
TTS_MODE=fish
FISH_API_KEY=
FISH_TTS_REFERENCE_ID=446c1dd88d4c4261989e6e000a716337
FISH_TTS_MODEL=s2-pro
FISH_TTS_URL=https://api.fish.audio/v1/tts
TTS_SAMPLE_RATE=24000
TTS_REQUEST_TIMEOUT_SECONDS=45

# Auth
JWT_SECRET=change_me
ADMIN_USER=admin
ADMIN_PASSWORD=change_me

# CORS — virgülle ayrılmış izin verilen origin listesi.
# Boş bırakılırsa tüm origin'lere izin verilir (sadece local dev).
# Prod: "https://panel.example.com"
CORS_ORIGINS=

# Backend timeout'ları (voice-runtime)
BACKEND_TIMEOUT_SECONDS=120
BACKEND_CONNECT_TIMEOUT_SECONDS=15

# Uygulama
LOG_LEVEL=INFO

# vLLM GPU bellek payi. 0.60 = egitim (QLoRA) canli modelin yaninda ayni GPUda
# calisabilsin diye ~19GB serbest birakir. Serve-only maksimum icin 0.85.
VLLM_GPU_MEMORY_UTILIZATION=0.60
