PROJECT_NAME=fine-tuned-agent
ENVIRONMENT=staging

# API Key koruması (X-API-Key header)
# Boş bırakılırsa kontrol atlanır → local dev için uygundur
# Prod'da doldur: openssl rand -hex 32
API_KEY=
# Internal-only token used to authorize candidate routing during eval runs.
# Required when ENVIRONMENT=production.
EVAL_INTERNAL_TOKEN=

# PostgreSQL
POSTGRES_DB=fine_tuned_agent
POSTGRES_USER=fine_tuned_agent
POSTGRES_PASSWORD=123456
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Internal backend URL used by the panel and eval worker
AGENT_BACKEND_URL=http://agent-backend:8010

# Eval worker
EVAL_REQUEST_TIMEOUT_SECONDS=45
EVAL_PASS_THRESHOLD=0.80
EVAL_JSON_VALIDITY_MIN=1.0
EVAL_REQUIRED_KEY_COVERAGE_MIN=1.0
EVAL_NEXT_ACTION_ACCURACY_MIN=0.80
EVAL_HARD_DECLINE_MIN=1.0
EVAL_IDENTITY_BEFORE_LINK_MIN=1.0
EVAL_PRICE_CORRECTNESS_MIN=1.0
EVAL_SECURITY_CORRECTNESS_MIN=1.0
EVAL_LOOP_REPETITION_MAX=0.0

# vLLM
# VLLM_MODE: "mock" = GPU'suz lokal geliştirme, "real" = GPU sunucu
VLLM_MODE=mock
VLLM_BASE_URL=http://vllm-server:8000/v1
VLLM_MODEL_NAME=fine-tuned-agent-v14
MODEL_HEALTH_TIMEOUT_SECONDS=15
ALLOW_MOCK_PRODUCTION_DEPLOY=false

# Isolated candidate serving slot (GPU profile)
CANDIDATE_MODEL_PATH=./models/candidates/current
CANDIDATE_MODEL_NAME=fine-tuned-agent-candidate
CANDIDATE_VLLM_BASE_URL=http://vllm-candidate:8000/v1

# Model yolları (GPU sunucuda)
MODEL_ACTIVE_VERSION=fine-tuned-agent-v14
MODEL_DIR=/models
MODEL_MERGED_PATH=./models/merged/fine-tuned-agent-v14

# Browser voice / LiveKit (Milestone 7)
LIVEKIT_URL=ws://livekit-server:7880
# Browser'ın erişebildiği URL. Prod'da wss://voice.example.com kullan.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
LIVEKIT_AGENT_NAME=fine-tuned-agent-voice

# Whisper STT modeli
# İndirmek için: bash infra/scripts/download_models.sh
WHISPER_MODEL_PATH=/models/whisper/whisper-large-v3-turbo-german
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=de
WHISPER_BEAM_SIZE=1

# M7 turn boundary ayarları. M8'de gelişmiş VAD/interruption ile değiştirilecek.
SPEECH_RMS_THRESHOLD=350
SPEECH_MIN_MS=250
SPEECH_END_SILENCE_MS=700
SPEECH_MAX_MS=20000
SPEECH_PREROLL_MS=240

# Fish Audio streaming TTS. Lokal stack smoke testi için TTS_MODE=mock kullanılabilir.
TTS_MODE=fish
FISH_API_KEY=
FISH_TTS_REFERENCE_ID=446c1dd88d4c4261989e6e000a716337
FISH_TTS_MODEL=s2-pro
FISH_TTS_URL=https://api.fish.audio/v1/tts
TTS_SAMPLE_RATE=24000
TTS_REQUEST_TIMEOUT_SECONDS=45

# Auth
JWT_SECRET=change_me
ADMIN_USER=admin
ADMIN_PASSWORD=change_me



# Uygulama
LOG_LEVEL=INFO
